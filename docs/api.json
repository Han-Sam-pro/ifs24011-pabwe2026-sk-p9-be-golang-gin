    "definitions": {
        "ai.GenerateRequest": {
            "type": "object",
            "required": [
                "topic"
            ],
            "properties": {
                "category": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Teknologi"
                },
                "include_web_search": {
                    "type": "boolean",
                    "example": true
                },
                "keywords": {
                    "type": "string",
                    "maxLength": 300,
                    "example": "AI, pembelajaran adaptif"
                },
                "max_sources": {
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1,
                    "example": 5
                },
                "tone": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "informatif"
                },
                "topic": {
                    "type": "string",
                    "maxLength": 300,
                    "minLength": 3,
                    "example": "Tren kecerdasan buatan di dunia pendidikan 2026"
                }
            }
        },
        "ai.GenerateResponse": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "excerpt": {
                    "type": "string"
                },
                "search_warning": {
                    "type": "string"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ai.SearchResult"
                    }
                },
                "title": {
                    "type": "string"
                },
                "web_search_used": {
                    "type": "boolean"
                }
            }
        },
        "ai.SearchResult": {
            "type": "object",
            "properties": {
                "snippet": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "admin"
                },
                "username": {
                    "type": "string",
                    "example": "admin"
                }
            }
        },
        "auth.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/auth.UserResponse"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 150,
                    "example": "budi@example.com"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2,
                    "example": "Budi Santoso"
                },
                "password": {
                    "type": "string",
