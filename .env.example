APP_ENV=development
APP_PORT=8081
APP_KEY=delcom_blog_secret_key_super_secure_2026_random_string_32chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Neon / cloud: isi DATABASE_URL (dipakai menggantikan DB_* di bawah), contoh:
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/pabwe_p9_blog?sslmode=require
DATABASE_URL=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pabwe_p9_blog
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

SEARCH_ENGINE_ENDPOINT=https://delcom.org/api/v1/search
OPENAI_ENDPOINT=https://delcom.org/api/v1
OPENAI_KEY=key
OPENAI_MODEL=nama-model
